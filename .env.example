# Copy to .env (or set these in your host's dashboard)
PORT=4000
NODE_ENV=development

# Required in production. Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# Where the SQLite database lives. In production put this on a persistent disk.
DB_PATH=./data/quiz.db

# First admin account, created automatically on startup if missing
ADMIN_EMAIL=admin@quiz.com
ADMIN_PASSWORD=admin123
